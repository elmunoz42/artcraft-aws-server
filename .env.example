# artcraft-cloud settings. Copy to .env (scripts/bootstrap.sh does this for you).
# App secrets are NOT here: they are generated into ${UPSTREAM_DIR}/.env on the server.

# Where everything stateful lives. On AWS this is the mount point of the EBS data volume.
DATA_DIR=/data/artcraft
# Checkout of the pinned artcraft-personal-server template (holds its .env and backups/).
UPSTREAM_DIR=/data/artcraft/upstream

# How often scripts/backup.sh runs (a systemd OnCalendar value such as "daily" or
# "*-*-* 03:30:00"). "off" installs no timer. The API pauses for the length of a backup.
BACKUP_SCHEDULE=daily

# ---- S3 sync add-on (docker/docker-compose.s3.yml) ----
S3_SYNC_ENABLED=false
S3_BUCKET=
S3_PREFIX=backups
SYNC_INTERVAL_SECONDS=300
# true = objects removed locally are also removed from the bucket. Leave false unless
# the bucket is versioned and you understand the effect of local backup retention.
SYNC_DELETE=false
# Needed outside EC2, or when the region cannot be detected from instance metadata.
AWS_REGION=
# Outside AWS only. On EC2 leave these empty: the instance role is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Public HTTPS add-on (docker/docker-compose.caddy.yml). EXPERIMENTAL, see docs/security.md ----
# Empty = no public access; reach the app through an SSM or SSH tunnel to localhost:4201.
DOMAIN_NAME=
BASIC_AUTH_USER=
# bcrypt hash from: docker run --rm -it caddy:2.11.9-alpine caddy hash-password
# Keep the single quotes; the hash contains "$".
BASIC_AUTH_HASH=''
